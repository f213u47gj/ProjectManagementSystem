@model ProjectManagementSystem.ViewModels.forUser.ProfileViewModel
@{
    ViewData["Title"] = "Настройки";
}

<div class="container" style="background-color: #f8f9fa; padding: 30px;">
    <h2 class="mb-4">Настройки</h2>

    <div class="row">
        <div class="col-md-3">
            <ul class="list-group mb-4">
                <li class="list-group-item active">Профиль</li>
                <a class="list-group-item" href="/Account/ChangePassword">Смена пароля</a>
                <a class="list-group-item" href="/Account/ChangeEmail">Смена почты</a>
            </ul>
        </div>

        <div class="col-md-9">
            <form asp-action="Profile" method="post">
                <div class="form-group mb-3">
                    <label>Аватарка</label><br />
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" style="width: 150px; height: 150px; border-radius: 15px;" />
                    }
                    else
                    {
                        <p>Нет аватарки</p>
                    }
                    <input asp-for="AvatarUrl" class="form-control mt-2" placeholder="Ссылка на аватар" />
                </div>

                <div class="form-group mb-3">
                    <label>Никнейм</label>
                    <input asp-for="UserName" class="form-control" />
                    <small class="form-text text-muted">
                        Состоит из букв, цифр и символов /./+/-/_. За недопустимый ник вы можете получить бан.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
            </form>
        </div>
    </div>
</div>
