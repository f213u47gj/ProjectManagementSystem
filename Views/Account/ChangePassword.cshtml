@model ProjectManagementSystem.ViewModels.forAccount.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}
<div class="container" style="background-color: #f8f9fa; padding: 30px;">
    <h2 class="mb-4">Настройки</h2>

    <div class="row">
        <div class="col-md-3">
            <ul class="list-group mb-4">
                <a class="list-group-item" href="/Account/Profile">Профиль</a>
                <li class="list-group-item active">Смена пароля</li>
                <a class="list-group-item" href="/Account/ChangeEmail">Смена почты</a>
            </ul>
        </div>

        <div class="col-md-9">
            <form asp-action="ChangePassword" method="post">
                <div class="form-group mb-3">
                    <label>Старый пароль</label>
                    <input asp-for="OldPassword" class="form-control" />
                    <span asp-validation-for="OldPassword" class="custom-error"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Новый пароль</label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="custom-error"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Подтверждение нового пароля</label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="custom-error"></span>
                </div>

                <button type="submit" class="btn btn-primary">Изменить пароль</button>

                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="text-danger mt-2">@error.ErrorMessage</div>
                }
            </form>
        </div>
    </div>
</div>

