@model ProjectManagementSystem.ViewModels.forUser.RegistrationViewModel

@{
    Layout = null;
}

<body>
    <div class="Login">
        <div class="square-container">
            <div class="register-text">Регистрация</div>
            <div class="separator"></div>

            <form method="post" asp-controller="Account" asp-action="Register">
                <div asp-validation-summary="ModelOnly" class="custom-error"></div>

                <div>
                    <span asp-validation-for="Email" class="custom-error"></span>
                    <input asp-for="Email" placeholder="Почта" autocomplete="off" />
                </div>

                <div>
                    <span asp-validation-for="UserName" class="custom-error"></span>
                    <input asp-for="UserName" placeholder="Имя пользователя" autocomplete="off" />
                </div>

                <div>
                    <span asp-validation-for="Password" class="custom-error"></span>
                    <input asp-for="Password" placeholder="Пароль" type="password" autocomplete="off" />
                </div>

                <div class="sunbit-but">
                    <input type="submit" value="Зарегистрироваться" />
                    <input type="button" value="Вход" onclick="location.href='@Url.Action("Login", "Account")'" class="enter-button" />
                </div>
            </form>
        </div>
    </div>
</body>

<link rel="stylesheet" href="~/css/forUser/account.css" asp-append-version="true" />

