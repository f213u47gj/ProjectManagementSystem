@model IEnumerable<ProjectManagementSystem.Models.Project>
@{
    ViewData["Title"] = "Мои проекты";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Мои проекты</h2>
        <a href="/Projects/Create" class="btn btn-primary">+ Новый проект</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">У вас пока нет проектов.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var project in Model)
            {
                <div class="col">
                    <a href="@Url.Action("Board", "Projects", new { id = project.Id })" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border border-light rounded hover-card">
                            <div class="card-body">
                                <h5 class="card-title">@project.Name</h5>
                                <p class="card-text text-muted">@project.Description</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-card {
        transition: background-color 0.3s ease;
    }

        .hover-card:hover {
            background-color: #f8f9fa; /* светло-серый */
        }
</style>
