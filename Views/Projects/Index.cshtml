@model IEnumerable<ProjectManagementSystem.Models.Project>
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Мои проекты";
    var currentUserId = UserManager.GetUserId(User);
}

<div class="projects-container">
    <div class="projects-header">
        <h2>Мои проекты</h2>
        <a href="/Projects/Create" class="btn btn-primary">+ Новый проект</a>
    </div>

    @if (!Model.Any())
    {
        <div class="no-projects-alert">У вас пока нет проектов.</div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var project in Model)
            {
                <div class="project-item">
                    <div class="project-card" data-project-id="@project.Id">
                        @if (project.OwnerId == currentUserId)
                        {
                            <button class="delete-project-btn"
                                    onclick="confirmDeleteProject('@project.Name', '@project.Id')">
                                <i class="fas fa-times"></i>
                            </button>
                        }

                        <a href="@Url.Action("Board", "Projects", new { id = project.Id })" class="project-link">
                            <div class="project-card-body">
                                <h5 class="project-title">@project.Name</h5>
                                <p class="project-description">
                                    @project.Description
                                </p>
                            </div>
                        </a>
                    </div>

                    @if (project.OwnerId == currentUserId)
                    {
                        <div id="context-menu-@project.Id" class="context-menu">
                            <button onclick="confirmDeleteProject('@project.Name', '@project.Id')">Удалить</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<div id="deleteProjectModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Удалить проект</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p>Вы действительно хотите удалить проект <strong id="projectToDeleteName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="deleteProjectForm" method="post">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-danger">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/forProject/index.css" />
}

@section Scripts {
    <script src="~/js/forProject/index.js"></script>
}