@model ProjectManagementSystem.ViewModels.Tasks.BoardViewModel
@{
    ViewData["Title"] = "Доска проекта";
    bool CanEdit = Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "Manager";
}

<link rel="stylesheet" href="~/css/forProject/board.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

@functions {
    public string GetStatusTitle(string status)
    {
        return status switch
        {
            "ToDo" => "📋 К выполнению",
            "InProgress" => "⏳ В процессе",
            "Done" => "✅ Готово",
            _ => status
        };
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@Model.Project.Name</h2>
        <div class="d-flex gap-2">
            @if (CanEdit)
            {
                <button class="btn btn-success" onclick="openCreateModalFromButton()">Создать задачу</button>
            }

            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    Детали
                </button>
                <ul class="dropdown-menu">
                    <a class="dropdown-item" href="/ProjectMembers/Index?projectId=@Model.Project.Id">Участники</a>
                    <li><a class="dropdown-item" href="/Projects/Details/@Model.Project.Id">О проекте</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div id="board" class="row p-4 mb-5 kanban-board">
        @foreach (var status in new[] { "ToDo", "InProgress", "Done" })
        {
            <div class="col-md-4 kanban-column" data-status="@status">
                <h4 class="text-center mb-3">@GetStatusTitle(status)</h4>
                <div class="d-flex flex-column gap-2 task-container" id="container-@status">
                    @foreach (var task in Model.Tasks.Where(t => t.Status == status))
                    {
                        <div class="card task-card" data-task-id="@task.Id" data-status="@task.Status" oncontextmenu="showTaskContextMenu(event, @task.Id)">
                            <div class="card-body">
                                <h5 class="card-title">@task.Title</h5>
                                <p class="card-text">Описание: @task.Description</p>
                                <p class="card-text">Срок сдачи: @task.DueDate?.ToString("dd.MM.yyyy")</p>

                                <div class="task-assignees mt-2 mb-2">
                                    @if (task.Assignees != null && task.Assignees.Any())
                                    {
                                        foreach (var assignee in task.Assignees)
                                        {
                                            <div class="d-inline-flex align-items-center me-2 mb-1">
                                                <img src="@(assignee.User?.AvatarUrl ?? "/images/default-avatar.png")"
                                                     class="rounded-circle me-1"
                                                     width="24"
                                                     height="24"
                                                     onerror="this.src='/images/default-avatar.png'"
                                                     alt="@assignee.User?.UserName">
                                                <small>@assignee.User?.UserName</small>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <small class="text-muted">Нет назначенных исполнителей</small>
                                    }
                                </div>

                                <div class="d-flex justify-content-start gap-3 text-muted small">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-chat-dots me-1"></i>
                                        <span>@(task.Comments?.Count ?? 0)</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-paperclip me-1"></i>
                                        <span>@(task.Attachments?.Count ?? 0)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="createTaskModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="createTaskForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Создать задачу</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
                    <input type="hidden" name="Status" value="ToDo" />

                    <div class="mb-3">
                        <label class="form-label">Название</label>
                        <input type="text" name="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Описание</label>
                        <textarea name="Description" class="form-control"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Срок</label>
                        <input type="date" name="DueDate" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Создать</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editTaskModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="editTaskForm">
            <div class="modal-content" style="border: 2px; border-color: black;">
                <div class="modal-header">
                    <h5 class="modal-title">Редактировать задачу</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editTaskId" />
                    <input type="hidden" name="ProjectId" value="@Model.Project.Id" />

                    <div class="mb-3">
                        <label class="form-label">Название</label>
                        <input type="text" name="Title" id="editTaskTitle" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Описание</label>
                        <textarea name="Description" id="editTaskDescription" class="form-control"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Статус</label>
                        <select name="Status" id="editTaskStatus" class="form-select">
                            <option value="ToDo">📋 К выполнению</option>
                            <option value="InProgress">⏳ В процессе</option>
                            <option value="Done">✅ Готово</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Срок</label>
                        <input type="date" name="DueDate" id="editTaskDueDate" class="form-control" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="viewTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="viewTaskTitle">Задача</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p><strong>Описание:</strong> <span id="viewTaskDescription"></span></p>
                <p><strong>Статус:</strong> <span id="viewTaskStatus"></span></p>
                <p><strong>Срок:</strong> <span id="viewTaskDueDate"></span></p>

                <div class="comments-section mt-4">
                    <h6 class="mb-3">💬 Комментарии</h6>

                    <div id="modalCommentsList" class="mb-3">
                        <p class="text-muted">Загрузка комментариев...</p>
                    </div>

                    <form id="modalCommentForm" class="d-flex flex-column" method="post">
                        @Html.AntiForgeryToken()
                        <textarea id="modalCommentInput" class="form-control mb-2" rows="2" placeholder="Напишите комментарий..." required></textarea>
                        <button type="submit" class="btn btn-primary align-self-end">Отправить</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Удалить задачу</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p>Вы действительно хотите удалить задачу <strong id="deleteTaskTitle"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="deleteTaskConfirmed()">Удалить</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assignAssigneeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Назначить исполнителя</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form id="assignAssigneeForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="assignTaskId" value="" />
                    <select id="assigneeSelect" class="form-select" required>
                        <option value="">Выберите исполнителя...</option>
                    </select>
                    <div id="currentAssignees" class="mt-3">
                        <h6>Текущие исполнители:</h6>
                        <ul id="assigneesList" class="list-group list-group-flush"></ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Назначить</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="attachmentsModal" tabindex="-1" aria-labelledby="attachmentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Вложения задачи</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>

            <div class="modal-body d-flex flex-column" style="max-height: 70vh;">
                <div id="attachmentsList" class="flex-grow-1 overflow-auto mb-3 border p-2 rounded" style="min-height: 150px;">
                </div>

                <form id="uploadForm" enctype="multipart/form-data" class="sticky-bottom bg-white pt-2 pb-1 border-top">
                    <input type="file" name="file" class="form-control mb-2" required>
                    <button type="submit" class="btn btn-primary w-100">Загрузить</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="taskContextMenu" class="position-absolute bg-white border rounded shadow-sm"
     style="display: none; z-index: 1000; min-width: 200px;">
    <ul class="list-unstyled mb-0">
        @if (CanEdit)
        {
            <li><button class="dropdown-item" onclick="viewTask()">Просмотр задачи</button></li>
            <li><button class="dropdown-item" onclick="assignUserToTask()">Назначить исполнителя</button></li>
            <li><button class="dropdown-item" onclick="editTask()">Редактировать задачу</button></li>
            <li><button class="dropdown-item" onclick="openAttachmentsModal()">Вложения</button></li>
            <li><button class="dropdown-item text-danger" onclick="confirmDeleteTask()">Удалить задачу</button></li>
        }
        else
        {
            <li><button class="dropdown-item" onclick="viewTask()">Просмотр задачи</button></li>

            @if (Model.IsAssignee)
            {
                <li><button class="dropdown-item" onclick="openAttachmentsModal()">Вложения</button></li>
            }
        }
    </ul>
</div>

@section Scripts {
    <script src="~/js/forProject/board.js"></script>
}
