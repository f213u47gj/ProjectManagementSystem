@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectManagementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectManagementSystem.styles.css" asp-append-version="true" />
    <style>
        .dropdown-item-btn {
            background: none;
            border: none;
            padding: 0.25rem 1rem;
            width: 100%;
            text-align: left;
        }

            .dropdown-item-btn:hover {
                background-color: #f8f9fa;
            }

        .navbar-brand img {
            height: 32px;
            margin-right: 8px;
        }

        .user-placeholder {
            font-weight: 600;
            padding: 0.5rem 1rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Projects" asp-action="Index">
                    <img src="/images/logo-icon.png" alt="Logo" />
                    <span class="fw-bold">СУП</span>
                </a>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    string avatarUrlRaw = User.FindFirst("AvatarUrl")?.Value;
                    string avatarUrl = string.IsNullOrWhiteSpace(avatarUrlRaw) ? null : avatarUrlRaw;

                    if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@avatarUrl" alt="Avatar" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Профиль</a></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item dropdown-item-btn">Выход</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle user-placeholder" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Профиль</a></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item dropdown-item-btn">Выход</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
