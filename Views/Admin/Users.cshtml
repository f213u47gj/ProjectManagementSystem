@model IEnumerable<ProjectManagementSystem.ViewModels.forAdmin.UserWithRolesViewModel>

@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0"><i class="fas fa-users-cog me-2"></i>Управление пользователями</h2>
                <a asp-action="Index" class="btn btn-light btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Назад
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Имя</th>
                            <th>Email</th>
                            <th>Роли</th>
                            <th>Проекты</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="text-muted">@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <div class="avatar-title bg-light rounded-circle text-primary">
                                                @user.UserName[0].ToString().ToUpper()
                                            </div>
                                        </div>
                                        <span>@user.UserName</span>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge @(role == "Admin" ? "bg-danger" : "bg-secondary") me-1">
                                            @role
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.Projects.Any())
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown">
                                                @user.Projects.Count() проектов
                                            </button>
                                            <ul class="dropdown-menu">
                                                @foreach (var project in user.Projects)
                                                {
                                                    <li>
                                                        <a class="dropdown-item" href="#">
                                                            <span class="fw-bold">@project.ProjectName</span>
                                                            <span class="badge bg-info float-end">@project.MemberRole</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Нет проектов</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form asp-action="UpdateRole" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="newRole" class="form-select form-select-sm w-auto">
                                                <option value="Admin">Admin</option>
                                                <option value="User">User</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="fas fa-sync-alt"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteUser" method="post"
                                              onsubmit="return confirm('Вы уверены, что хотите удалить этого пользователя?');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-sm {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .avatar-title {
            font-size: 0.875rem;
            font-weight: 600;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .dropdown-menu {
            max-height: 300px;
            overflow-y: auto;
        }

        .badge {
            font-weight: 500;
            letter-spacing: 0.5px;
        }
    </style>
}